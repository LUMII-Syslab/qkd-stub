        <mxCell id="H72MMAwUgzyrUTCpQraT-25" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#52677C;fontStyle=0;align=left;verticalAlign=middle;spacing=16;spacing=0;align=center;" value="14" vertex="1">
