        <mxCell id="XVQUhR2G2x-bOHj4k4DN-11" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontFamily=Helvetica;fontSize=16;fontColor=#10243A;fontStyle=0;align=left;verticalAlign=middle;spacing=16;spacing=0;" value="&lt;b&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;1  Request key for B&lt;/font&gt;&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/span&gt;&lt;font face=&quot;Courier New&quot; style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;GET /api/v1/keys/&lt;b&gt;B&lt;/b&gt;/&lt;br&gt;enc_keys?size=256&lt;/font&gt;&lt;/div&gt;" vertex="1">
