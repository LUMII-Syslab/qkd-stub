        <mxCell id="H72MMAwUgzyrUTCpQraT-26" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#52677C;fontStyle=0;align=left;verticalAlign=middle;spacing=16;spacing=0;align=center;" value="15" vertex="1">
          <mxGeometry height="18" width="90" x="1420" y="108" as="geometry" />
        </mxCell>
        <mxCell id="H72MMAwUgzyrUTCpQraT-27" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#52677C;fontStyle=0;align=left;verticalAlign=middle;spacing=16;spacing=0;" value="Bytes 0–1: length, 1–8192 bytes; bytes 2–5: SAE codes.&lt;br&gt;Unsigned big-endian. Bound: codes 1–65535; unbound: both 0." vertex="1">
          <mxGeometry height="57" width="530" x="70" y="188" as="geometry" />
        </mxCell>
        <mxCell id="H72MMAwUgzyrUTCpQraT-28" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#52677C;fontStyle=0;align=left;verticalAlign=middle;spacing=16;spacing=0;" value="Bytes 6–14: nine fresh random bytes per attempt.&lt;br&gt;The version and variant are checked only after encryption." vertex="1">
          <mxGeometry height="57" width="660" x="610" y="188" as="geometry" />
        </mxCell>
        <mxCell id="H72MMAwUgzyrUTCpQraT-29" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#52677C;fontStyle=0;align=left;verticalAlign=middle;spacing=16;spacing=0;align=center;" value="Byte 15: keyed check&lt;br&gt;PRK + P[0:15]" vertex="1">
          <mxGeometry height="57" width="210" x="1300" y="188" as="geometry" />
        </mxCell>
        <mxCell id="v7-plaintext" value="PLAINTEXT P · internal only" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=14;fontColor=#10243A;align=left;verticalAlign=middle;spacing=10;">
          <mxGeometry as="geometry" x="70" y="88" width="1440" height="25" />
        </mxCell>
        <mxCell id="v7-aes" value="↓  AES-256 encrypts the entire block using the PSK-derived AES key  ↓" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF7FF;strokeColor=#1663A6;fontFamily=Helvetica;fontSize=18;fontColor=#10243A;align=center;verticalAlign=middle;spacing=10;">
          <mxGeometry as="geometry" x="70" y="262" width="1440" height="45" />
        </mxCell>
        <mxCell id="v7-cipher-title" value="PUBLIC CIPHERTEXT C · displayed as a lowercase, hyphenated UUID" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=18;fontColor=#10243A;align=left;verticalAlign=middle;spacing=10;">
          <mxGeometry as="geometry" x="70" y="321" width="1440" height="30" />
        </mxCell>
        <mxCell id="v7-cipher-a" value="Encrypted bits" vertex="1" parent="1" style="whiteSpace=wrap;html=1;fillColor=#EFF7FF;strokeColor=#1663A6;fontFamily=Helvetica;fontSize=16;fontColor=#10243A;align=center;spacing=0;">
          <mxGeometry as="geometry" x="70" y="365" width="540" height="49" />
        </mxCell>
        <mxCell id="v7-cipher-v" value="4" vertex="1" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#1663A6;fontFamily=Helvetica;fontSize=16;fontColor=#10243A;align=center;spacing=0;">
          <mxGeometry as="geometry" x="610" y="365" width="45" height="49" />
        </mxCell>
        <mxCell id="v7-cipher-b" value="Encrypted" vertex="1" parent="1" style="whiteSpace=wrap;html=1;fillColor=#EFF7FF;strokeColor=#1663A6;fontFamily=Helvetica;fontSize=16;fontColor=#10243A;align=center;spacing=0;">
          <mxGeometry as="geometry" x="655" y="365" width="135" height="49" />
        </mxCell>
        <mxCell id="v7-cipher-var" value="10" vertex="1" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#1663A6;fontFamily=Helvetica;fontSize=16;fontColor=#10243A;align=center;spacing=0;">
          <mxGeometry as="geometry" x="790" y="365" width="22.5" height="49" />
        </mxCell>
        <mxCell id="v7-cipher-c" value="Encrypted bits" vertex="1" parent="1" style="whiteSpace=wrap;html=1;fillColor=#EFF7FF;strokeColor=#1663A6;fontFamily=Helvetica;fontSize=16;fontColor=#10243A;align=center;spacing=0;">
          <mxGeometry as="geometry" x="812.5" y="365" width="697.5" height="49" />
        </mxCell>
        <mxCell id="v7-filter" value="&lt;b&gt;Accept only:&lt;/b&gt; C[6] high 4 bits = 0100 (version 4), and C[8] high 2 bits = 10 (variant).&lt;br&gt;Otherwise regenerate P[6:15], recompute the check, and encrypt again. Never overwrite ciphertext bits." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=18;fontColor=#10243A;align=left;verticalAlign=middle;spacing=10;">
          <mxGeometry as="geometry" x="70" y="428" width="1440" height="65" />
        </mxCell>
        <mxCell id="v7-limits" value="About 64 attempts per ID; 4096 failed attempts → HTTP 503. Approximately 2⁶⁶ accepted IDs per fixed SAE pair / length.&lt;br&gt;Checksum is an 8-bit error check, not authentication. Format v7 is unrelated to UUIDv7; older plaintext UUIDv8 IDs are rejected." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=17;fontColor=#10243A;align=left;verticalAlign=middle;spacing=10;">
          <mxGeometry as="geometry" x="70" y="501" width="1440" height="65" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="sBJFMoNtCSBWDahgKInY" name="Key Derivation">
    <mxGraphModel dx="2054" dy="1206" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="800" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v7-title" value="&lt;b&gt;Key derivation · format v7&lt;/b&gt; — HKDF-SHA512 + AES-256" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=25;fontColor=#10243A;align=left;verticalAlign=middle;spacing=10;">
          <mxGeometry as="geometry" x="40" y="30" width="1500" height="45" />
        </mxCell>
        <mxCell id="panel-0" value="" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF7FF;strokeColor=#1663A6;fontFamily=Helvetica;fontSize=18;fontColor=#10243A;align=left;verticalAlign=middle;spacing=10;">
          <mxGeometry as="geometry" x="40" y="100" width="480" height="260" />
        </mxCell>
        <mxCell id="title-0" value="&lt;b&gt;1  Extract shared secret&lt;/b&gt;" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=21;fontColor=#10243A;align=left;verticalAlign=middle;spacing=10;">
          <mxGeometry as="geometry" x="52" y="108" width="456" height="38" />
        </mxCell>
        <mxCell id="formula-0" value="PRK = HKDF-Extract-SHA512(&lt;br&gt;  salt = &quot;qkd-stub:psk&quot; || 0x00,&lt;br&gt;  IKM = shared 32-byte PSK)" vertex="1" parent="1" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Courier New;fontSize=17;fontColor=#10243A;align=left;verticalAlign=middle;spacing=8;">
          <mxGeometry as="geometry" x="52" y="155" width="456" height="127" />
        </mxCell>
        <mxCell id="note-0" value="Both stubs compute the same PRK." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=16;fontColor=#10243A;align=left;verticalAlign=middle;spacing=10;">
          <mxGeometry as="geometry" x="52" y="292" width="456" height="58" />
        </mxCell>
        <mxCell id="panel-1" value="" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF7FF;strokeColor=#1663A6;fontFamily=Helvetica;fontSize=18;fontColor=#10243A;align=left;verticalAlign=middle;spacing=10;">
          <mxGeometry as="geometry" x="550" y="100" width="480" height="260" />
        </mxCell>
        <mxCell id="title-1" value="&lt;b&gt;2  Derive AES key&lt;/b&gt;" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=21;fontColor=#10243A;align=left;verticalAlign=middle;spacing=10;">
          <mxGeometry as="geometry" x="562" y="108" width="456" height="38" />
        </mxCell>
        <mxCell id="formula-1" value="AES_key = Expand(PRK,&lt;br&gt;  &quot;qkd-stub:id-encryption:v7&quot; || 0x00,&lt;br&gt;  32)" vertex="1" parent="1" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Courier New;fontSize=17;fontColor=#10243A;align=left;verticalAlign=middle;spacing=8;">
          <mxGeometry as="geometry" x="562" y="155" width="456" height="127" />
        </mxCell>
        <mxCell id="note-1" value="AES-256 key: 32 bytes." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=16;fontColor=#10243A;align=left;verticalAlign=middle;spacing=10;">
          <mxGeometry as="geometry" x="562" y="292" width="456" height="58" />
        </mxCell>
        <mxCell id="panel-2" value="" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF7FF;strokeColor=#1663A6;fontFamily=Helvetica;fontSize=18;fontColor=#10243A;align=left;verticalAlign=middle;spacing=10;">
          <mxGeometry as="geometry" x="1060" y="100" width="480" height="260" />
        </mxCell>
        <mxCell id="title-2" value="&lt;b&gt;3  Build plaintext + checksum&lt;/b&gt;" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=21;fontColor=#10243A;align=left;verticalAlign=middle;spacing=10;">
          <mxGeometry as="geometry" x="1072" y="108" width="456" height="38" />
        </mxCell>
        <mxCell id="formula-2" value="P[15] = Expand(PRK,&lt;br&gt;  &quot;qkd-stub:id-check:v7&quot; || 0x00&lt;br&gt;  || P[0:15], 1)[0]" vertex="1" parent="1" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Courier New;fontSize=17;fontColor=#10243A;align=left;verticalAlign=middle;spacing=8;">
          <mxGeometry as="geometry" x="1072" y="155" width="456" height="127" />
        </mxCell>
        <mxCell id="note-2" value="P contains length, SAE codes and 72 random bits." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=16;fontColor=#10243A;align=left;verticalAlign=middle;spacing=10;">
          <mxGeometry as="geometry" x="1072" y="292" width="456" height="58" />
        </mxCell>
        <mxCell id="panel-3" value="" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFFAF5;strokeColor=#127B66;fontFamily=Helvetica;fontSize=18;fontColor=#10243A;align=left;verticalAlign=middle;spacing=10;">
          <mxGeometry as="geometry" x="40" y="390" width="480" height="260" />
        </mxCell>
        <mxCell id="title-3" value="&lt;b&gt;4  Encrypt and filter&lt;/b&gt;" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=21;fontColor=#10243A;align=left;verticalAlign=middle;spacing=10;">
          <mxGeometry as="geometry" x="52" y="398" width="456" height="38" />
        </mxCell>
        <mxCell id="formula-3" value="C = AES-256-Encrypt-Block(AES_key, P)&lt;br&gt;&lt;br&gt;Accept: (C[6] &gt;&gt; 4) = 4&lt;br&gt;    and (C[8] &gt;&gt; 6) = 2" vertex="1" parent="1" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Courier New;fontSize=17;fontColor=#10243A;align=left;verticalAlign=middle;spacing=8;">
          <mxGeometry as="geometry" x="52" y="445" width="456" height="127" />
        </mxCell>
        <mxCell id="note-3" value="Else refresh random bytes, recheck and re-encrypt.&lt;br&gt;Mean: 64 attempts; limit: 4096 → HTTP 503." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=16;fontColor=#10243A;align=left;verticalAlign=middle;spacing=10;">
          <mxGeometry as="geometry" x="52" y="582" width="456" height="58" />
        </mxCell>
        <mxCell id="panel-4" value="" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFFAF5;strokeColor=#127B66;fontFamily=Helvetica;fontSize=18;fontColor=#10243A;align=left;verticalAlign=middle;spacing=10;">
          <mxGeometry as="geometry" x="550" y="390" width="480" height="260" />
        </mxCell>
        <mxCell id="title-4" value="&lt;b&gt;5  Derive output key&lt;/b&gt;" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=21;fontColor=#10243A;align=left;verticalAlign=middle;spacing=10;">
          <mxGeometry as="geometry" x="562" y="398" width="456" height="38" />
        </mxCell>
        <mxCell id="formula-4" value="key = Expand(PRK,&lt;br&gt;  &quot;qkd-stub:key:v7&quot; || 0x00 || C,&lt;br&gt;  key_length_bytes)" vertex="1" parent="1" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Courier New;fontSize=17;fontColor=#10243A;align=left;verticalAlign=middle;spacing=8;">
          <mxGeometry as="geometry" x="562" y="445" width="456" height="127" />
        </mxCell>
        <mxCell id="note-4" value="All 128 ciphertext bits are used.&lt;br&gt;Output: 1–8192 bytes, returned as Base64." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=16;fontColor=#10243A;align=left;verticalAlign=middle;spacing=10;">
          <mxGeometry as="geometry" x="562" y="582" width="456" height="58" />
        </mxCell>
        <mxCell id="panel-5" value="" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFFAF5;strokeColor=#127B66;fontFamily=Helvetica;fontSize=18;fontColor=#10243A;align=left;verticalAlign=middle;spacing=10;">
          <mxGeometry as="geometry" x="1060" y="390" width="480" height="260" />
        </mxCell>
        <mxCell id="title-5" value="&lt;b&gt;Retrieval on the second stub&lt;/b&gt;" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=21;fontColor=#10243A;align=left;verticalAlign=middle;spacing=10;">
          <mxGeometry as="geometry" x="1072" y="398" width="456" height="38" />
        </mxCell>
        <mxCell id="formula-5" value="Validate UUID notation + v4 bits.&lt;br&gt;Decrypt C → P; validate length + check.&lt;br&gt;Authorize the decrypted SAE pair.&lt;br&gt;Run step 5 using the original C." vertex="1" parent="1" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Courier New;fontSize=17;fontColor=#10243A;align=left;verticalAlign=middle;spacing=8;">
          <mxGeometry as="geometry" x="1072" y="445" width="456" height="127" />
        </mxCell>
        <mxCell id="note-5" value="Invalid ID → 400; wrong SAE pair → 401.&lt;br&gt;Any invalid member rejects the whole batch." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=16;fontColor=#10243A;align=left;verticalAlign=middle;spacing=10;">
          <mxGeometry as="geometry" x="1072" y="582" width="456" height="58" />
        </mxCell>
        <mxCell id="v7-legend" value="Expand = HKDF-Expand-SHA512. Labels are ASCII; || means concatenation; 0x00 is one zero byte.&lt;br&gt;P and C are raw bytes, not UUID text. Slices exclude the upper bound. The checksum is not authentication." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=17;fontColor=#10243A;align=left;verticalAlign=middle;spacing=10;">
          <mxGeometry as="geometry" x="40" y="671" width="1500" height="60" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>