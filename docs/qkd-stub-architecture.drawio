        <mxCell id="XVQUhR2G2x-bOHj4k4DN-7" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1663A6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=24;fontColor=#10243A;fontStyle=0;align=left;verticalAlign=middle;spacing=16;spacingLeft=75;" value="&lt;b&gt;Client 1 · SAE&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;color: rgb(82, 103, 124); font-size: 17px;&quot;&gt;(Secure Application Entity)&lt;/span&gt;&lt;b&gt;&amp;nbsp;A&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52677C&quot; style=&quot;font-size: 17px;&quot;&gt;In mTLS, client certificate DN / SAN identifies SAE A&lt;/font&gt;" vertex="1">
