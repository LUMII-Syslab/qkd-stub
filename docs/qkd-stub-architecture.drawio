        </mxCell>
        <mxCell id="XVQUhR2G2x-bOHj4k4DN-8" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1663A6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=18;fontColor=#10243A;fontStyle=0;align=left;verticalAlign=middle;spacing=16;verticalAlign=top;spacingTop=4;spacingLeft=75;" value="&lt;b&gt;KME (Key Management Entity) · stub A · Issue&lt;/b&gt;&lt;ol&gt;&lt;li&gt;Authenticate SAE A; resolve recipient B.&lt;/li&gt;&lt;li&gt;Pack length, SAE codes, 72 random bits + check.&lt;/li&gt;&lt;li&gt;AES-encrypt; retry until UUIDv4 bits match.&lt;/li&gt;&lt;li&gt;Derive key from PSK + full ciphertext UUID.&lt;/li&gt;&lt;/ol&gt;" vertex="1">
          <mxGeometry height="172" width="622" x="64" y="311" as="geometry" />
        </mxCell>
